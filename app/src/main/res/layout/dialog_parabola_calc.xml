<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPointsHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Выявлены 3 точки на параболе:"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary" />

        <TextView
            android:id="@+id/tvSystemHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Система уравнений (a·x² + b·x + c = y):"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Coefficient Inputs a, b, c -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/label_a">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDialogA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textVisiblePassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvEvalA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="= ?"
            android:textSize="12sp"
            android:textStyle="italic"
            android:textColor="?attr/colorSecondary" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/label_b">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDialogB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textVisiblePassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvEvalB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="= ?"
            android:textSize="12sp"
            android:textStyle="italic"
            android:textColor="?attr/colorSecondary" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/label_c">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDialogC"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textVisiblePassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvEvalC"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="= ?"
            android:textSize="12sp"
            android:textStyle="italic"
            android:textColor="?attr/colorSecondary" />

        <TextView
            android:id="@+id/tvDialogFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAlignment="center"
            android:textSize="13sp"
            android:textColor="?attr/colorError" />

    </LinearLayout>
</ScrollView>
