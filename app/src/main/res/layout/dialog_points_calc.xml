<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPointsHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Выявленные точки:"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary" />

        <!-- Step 1: k -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_step1_k"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="Выражение для k (например: (7-3)/(4-2))">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDialogK"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textVisiblePassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvEvalK"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="= ?"
            android:textSize="12sp"
            android:textStyle="italic"
            android:textColor="?attr/colorSecondary" />

        <!-- Step 2: b -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/label_step2_b"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="Выражение для b (например: 3 - 2*1)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDialogB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textVisiblePassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvEvalB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="= ?"
            android:textSize="12sp"
            android:textStyle="italic"
            android:textColor="?attr/colorSecondary" />

        <TextView
            android:id="@+id/tvDialogFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAlignment="center"
            android:textSize="13sp"
            android:textColor="?attr/colorError" />

    </LinearLayout>
</ScrollView>
